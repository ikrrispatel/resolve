# Sandbox mode needs no personal wallet. Keys are generated in memory.
PORT=4310
# Required only for the real OpenAI Agents JS consumer workflow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-side Next.js proxy origin for hosted frontend builds.
# Set to the reachable Resolve API origin in Vercel; never use NEXT_PUBLIC_.
RESOLVE_API_ORIGIN=

# Resolve API server only: exact hosted frontend origin permitted to run demos.
RESOLVE_FRONTEND_ORIGIN=
